@model IEnumerable<dynamic>

<h2>Requests By Status</h2>

<table class="table table-bordered">
    <thead>
        <tr><th>Status</th><th>Count</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Status</td>
                <td>@item.Count</td>
            </tr>
        }
    </tbody>
</table>
