@model IEnumerable<dynamic>

<h2>Latest 10 Service Requests</h2>

<table class="table table-hover">
    <thead>
        <tr><th>Description</th><th>Status</th><th>Request Date</th><th>Username</th><th>Apartment Number</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Description</td>
                <td>@item.Status</td>
                <td>@item.RequestDate.ToShortDateString()</td>
                <td>@item.Username</td>
                <td>@item.ApartmentNumber</td>
            </tr>
        }
    </tbody>
</table>
