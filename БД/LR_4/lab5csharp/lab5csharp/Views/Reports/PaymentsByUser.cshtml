@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Payments By User";
}

<h1>Payments By User</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Username</th>
            <th>Total Paid</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Username</td>
                <td>@item.TotalPaid.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>
